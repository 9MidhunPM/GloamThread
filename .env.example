# Copy to .env and add your own key. .env is ignored; never commit credentials.
OPENAI_API_KEY=
# Cheap initial experiment; scheduled to retire 2026-12-01. Configurable, no fallback.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low
# Explicit total local allowance; previous reservations are always retained.
# Each character job is still limited to $0.50. This is not an API billing limit.
FORGE_TOTAL_BUDGET_USD=2.00
