extends Scenario


func run() -> void:
	var app := ArenaApp.new()
	add_child(app)
	await ticks(2)
	assert_eq(app.screen, "title", "actual new App starts on arena title")
	assert_true(app.font != null and app.bundles.size() >= 2, "original font and fighters loaded")
	app._show_lobby(1)
	assert_eq(app.roster_size, 1, "solo choice fixes roster")
	app._begin_run()
	await ticks(2)
	assert_eq(app.world_view.size, Vector2i(640, 360), "one arena viewport has full16:9logicalsize")
	assert_eq(app.world_container.scale, Vector2(3, 3), "world scales exactly3xfor1080p")
	assert_eq(app.session.fighters.size(), 1, "actual solo App creates one fighter")
	app._show_pause()
	assert_true(get_tree().paused, "actual pause freezes sharedtree")
	app._resume()
	assert_true(not get_tree().paused, "resume deliberately restarts sharedtree")
	app._show_title()
	app._show_lobby(2)
	app._begin_run()
	await ticks(2)
	assert_eq(app.session.fighters.size(), 2, "actual co-op App creates exactlytwofighters")
	assert_true(app.session.fighters[0].get_world_2d() == app.session.fighters[1].get_world_2d(), "bothfighters inhabitonesharedworld")
	app.session._open_shop()
	assert_eq(app.shop_buttons.size(), 2, "twoindependentshoppanels")
	app._open_creator(0)
	assert_eq(app.screen, "creator", "actualAppopenscreator")
	assert_true(is_instance_valid(app.creator), "creationinterfaceinstantiated")
	app._show_title()
