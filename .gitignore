# Local secrets; sanitized example files may be committed.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Common dependencies, build output, caches, and local tooling.
node_modules/
.next/
dist/
build/
coverage/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
Thumbs.db
*.log

# Godot 4 editor cache and local state (generated on import; never commit).
.godot/
*.tmp
export_presets.cfg.credentials

# Editor lock files (LibreOffice and similar) left while a document is open.
.~lock.*#

# Evidence captures can be large; keep curated stills, ignore raw movie dumps.
evidence/raw/
